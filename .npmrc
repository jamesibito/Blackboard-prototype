# Vercel + CI need this because puppeteer-screen-recorder@3 peer-deps on
# puppeteer@19.0.0, while we install puppeteer@24 for the local capture
# scripts (capture-case-study-screens.mjs, capture-case-study-videos.mjs).
# Both packages are devDependencies and not loaded by the app at runtime —
# they only matter for regenerating the case-study screenshots locally.
#
# This setting makes `npm install` use the same resolution behaviour we
# used locally, so production builds don't fail on the peer-dep conflict.
legacy-peer-deps=true
